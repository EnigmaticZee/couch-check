# Copy this file to .env and fill in your key. .env is git-ignored: never commit a real key,
# and never paste it into chats, issues or screenshots.

# Live AI scoring through Groq's free tier (OpenAI-compatible).
# Create a key at https://console.groq.com/keys, on an account with no payment method.
# Check the model name in Groq's console (Settings > Limits); models change over time.
# gpt-oss models automatically use light reasoning (PG_AI_REASONING_EFFORT=low) to save tokens.
PG_AI_BASE_URL=https://api.groq.com/openai/v1
PG_AI_API_KEY=
PG_AI_MODEL=openai/gpt-oss-120b

# Pacing and limits. Calls are spaced this many seconds apart; when Groq says to slow down,
# AI scoring pauses and new titles show the keyword estimate until it resumes.
PG_AI_MIN_INTERVAL=1.5
PG_AI_DAILY_LIMIT=500
